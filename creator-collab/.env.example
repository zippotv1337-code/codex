# Creator Ops configuration example — never place real secrets in this file.

# Provider-neutral secret access. Values stay in the selected provider; only
# aliases and empty runtime fallback variables belong in this example.
ZIPPOWORKZ_SECRET_PROVIDER=
ZIPPOWORKZ_SECRET_NAMESPACE=zippoworkz
TIKTOK_CLIENT_KEY_ALIAS=secret://tiktok/client_key
TIKTOK_CLIENT_SECRET_ALIAS=secret://tiktok/client_secret
META_ACCESS_TOKEN_ALIAS=secret://meta/access_token
META_LEONA_USER_ID_ALIAS=secret://meta/leona-voss/ig-user-id
META_LEONA_ACCESS_TOKEN_ALIAS=secret://meta/leona-voss/access-token
META_MARA_USER_ID_ALIAS=secret://meta/mara-field/ig-user-id
META_MARA_ACCESS_TOKEN_ALIAS=secret://meta/mara-field/access-token
GITHUB_TOKEN_ALIAS=secret://github/token

# Required only when listening beyond localhost. Minimum 12 characters.
CREATOR_OPS_PASSWORD=
META_IG_USER_ID_LEONA_VOSS=
META_ACCESS_TOKEN_LEONA_VOSS=
META_IG_USER_ID_MARA_FIELD=
META_ACCESS_TOKEN_MARA_FIELD=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GITHUB_TOKEN=
META_GRAPH_API_VERSION=
# Defaults to the current Instagram Login API. Use graph.facebook.com only
# with the linked-Page/Facebook-Login permission model.
META_GRAPH_HOST=graph.instagram.com
CREATOR_OPS_META_MEDIA_MANIFEST=

# Optional notification URL for the temporary remote helper.
# Keep the real value in the local environment, never in Git or SQLite.
CREATOR_OPS_NOTIFY_URL=

# Publishing, payments and paid ads remain disabled until a dedicated,
# owner-approved official adapter is configured.
CREATOR_OPS_PUBLISH_MODE=dry-run
CREATOR_OPS_PAID_SPEND_ENABLED=false
