{
  "schema": "zippoworkz-connector-secret-catalog-v1",
  "policy": {
    "values_in_git": false,
    "values_in_logs": false,
    "values_in_prompts": false,
    "node_storage": "DPAPI CurrentUser",
    "replication": "RSA-OAEP encrypted bundle"
  },
  "connectors": {
    "meta-instagram": {
      "worker": "creator-ops-meta",
      "replicate": true,
      "status": "READY_VPS",
      "accounts": ["leonavoss.ai", "mara.field.ai"],
      "secret_names": [
        "META_IG_USER_ID_LEONA_VOSS",
        "META_ACCESS_TOKEN_LEONA_VOSS",
        "META_IG_USER_ID_MARA_FIELD",
        "META_ACCESS_TOKEN_MARA_FIELD",
        "META_GRAPH_API_VERSION",
        "META_GRAPH_HOST"
      ]
    },
    "creator-ops-web": {
      "worker": "creator-ops-web",
      "replicate": true,
      "status": "READY_VPS",
      "secret_names": ["CREATOR_OPS_PASSWORD"]
    },
    "higgsfield": {
      "worker": "media-higgsfield",
      "replicate": true,
      "status": "LEGACY_ENV_VPS_PENDING_BROKER",
      "secret_names": ["HF_KEY"],
      "owner_gate": "ASK_BEFORE_EVERY_PAID_HIGGSFIELD_CALL"
    },
    "github": {
      "worker": "managed-connector",
      "replicate": false,
      "status": "MANAGED_AUTH",
      "secret_names": []
    },
    "tiktok": {
      "worker": "creator-ops-tiktok",
      "replicate": true,
      "status": "PENDING_OWNER_OAUTH",
      "secret_names": [
        "TIKTOK_CLIENT_KEY",
        "TIKTOK_CLIENT_SECRET",
        "TIKTOK_REDIRECT_URI",
        "TIKTOK_ACCESS_TOKEN",
        "TIKTOK_REFRESH_TOKEN",
        "TIKTOK_OPEN_ID",
        "TIKTOK_SCOPES"
      ]
    },
    "fiverr": {
      "worker": "creator-ops-fiverr",
      "replicate": true,
      "status": "PENDING_API_CREDENTIALS",
      "secret_names": []
    }
  }
}
